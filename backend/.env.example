NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL="file:./prisma/dev.db"

# Auth - JWT access token (minimum 32 characters)
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m

# Auth - Refresh token lifetime in days
REFRESH_TOKEN_TTL_DAYS=30

# Google OAuth (Client ID only — never put the secret here)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
